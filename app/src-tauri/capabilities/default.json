{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may listen to Yolmira's events and call Yolmira's own commands, nothing else: no shell, filesystem or other plugins (ARCHITECTURE §6.5). Local content only.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-daemon-state",
    "allow-daemon-start",
    "allow-session-list",
    "allow-session-create",
    "allow-session-attach",
    "allow-session-ack",
    "allow-session-detach",
    "allow-session-input",
    "allow-session-resize",
    "allow-session-kill",
    "allow-project-list",
    "allow-project-add",
    "allow-project-remove",
    "allow-policy-pending",
    "allow-policy-code",
    "allow-policy-answer"
  ]
}
